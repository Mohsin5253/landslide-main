# Database (SQLite by default; use postgresql:// on Render)
DATABASE_URL=sqlite:///./nexusland.db
# Production Render PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Host / Public Service URLs
BACKEND_URL=http://localhost:8000
# On Render: BACKEND_URL=https://your-service-name.onrender.com

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# On Render: FRONTEND_URL=https://your-frontend-app.vercel.app

# Security & Authentication
SECRET_KEY=nexusland-super-secret-key-change-in-production-2024
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# External APIs (Optional - fallbacks are built-in)
GROQ_API_KEY=your-groq-api-key
CESIUM_ION_TOKEN=your-cesium-ion-token
WEATHER_API_KEY=your-weather-api-key
