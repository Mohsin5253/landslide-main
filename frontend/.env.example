# Backend API URL (set this in Vercel dashboard → Project Settings → Environment Variables)
# For production: https://your-backend-name.onrender.com/api
# For local dev:  http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID (optional — dev bypass token works without it)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=mock-client-id
